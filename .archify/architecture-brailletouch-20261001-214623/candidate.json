  "cards": [
    {
      "dot": "cyan",
      "title": "Capture path",
      "items": [
        "Dashboard only pokes the camera; the JPEG returns on a second request",
        "/api/capture waits for OCR + summary before replying (camera allows 20s)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Playback loop",
      "items": [
        "Motors on 1.2s → off → 0.4s pause → next char/word/sentence",
        "Every state change is broadcast to all dashboards"
      ]
    },
    {
      "dot": "amber",
      "title": "Fail-soft",
      "items": [
        "Failed OCR gives empty text; failed summary falls back to OCR text",
        "Unreachable motor ESP32 is logged and playback continues"
      ]
    },
    {
      "dot": "rose",
      "title": "Known gaps",
      "items": [
        "Session never passes speak_char, so the speaker is idle during playback",
        "Only a–z are mapped; digits and punctuation are dropped",
        "Device IPs are DHCP-assigned; keep config.py current"
      ]
    }
  ]
